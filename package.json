{
  "name": "slack-hop",
  "version": "0.1.0",
  "description": "CLI that lets AI agents read and post in multiple Slack workspaces",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jason-ezenwa/slack-hop.git"
  },
  "homepage": "https://github.com/jason-ezenwa/slack-hop#readme",
  "bugs": {
    "url": "https://github.com/jason-ezenwa/slack-hop/issues"
  },
  "type": "module",
  "bin": {
    "slack-hop": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
